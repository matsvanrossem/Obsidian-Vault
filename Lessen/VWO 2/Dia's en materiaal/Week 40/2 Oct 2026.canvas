		{"id":"da84af66feb049c5","type":"text","text":"\n## **08:15** -\tWords F overview\n## **08:25** -\tPractice 37 Together\n## **08:35** - Make The Lesson F Exercises\n## **08:50** - Questionaire\n## **08:57** -\tWrap up and homework ","x":-125,"y":-30,"width":649,"height":292,"color":"4"},
