		{"id":"f806ca36a320f07f","type":"text","text":"\n## **08:15** -\tMini test Lessonup\n## **08:20** - Extra Instruction or Creative Exercise\n## **08:50** - Kwizl classroom\n","x":-324,"y":-107,"width":649,"height":155,"color":"4"},
